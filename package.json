{
  "name": "fer-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:db": "node --env-file=.env.local --test scripts/test-db.mjs",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x studio,mailpit,imgproxy,edge-runtime,logflare,vector,realtime,storage-api,postgres-meta,supavisor",
    "db:reset": "supabase db reset",
    "demo:seed": "node --env-file=.env.local scripts/seed-demo.mjs",
    "test:atomic": "docker exec -i supabase_db_feria psql -U postgres -v ON_ERROR_STOP=1 < tests/sales-rollback.sql",
    "test:collections": "node --env-file=.env.local --test scripts/test-collections.mjs",
    "test:collection-atomic": "docker exec -i supabase_db_feria psql -U postgres -v ON_ERROR_STOP=1 < tests/collection-rollback.sql",
    "test:operations": "node --env-file=.env.local --test scripts/test-operations.mjs",
    "test:intelligence": "node --env-file=.env.local --test scripts/test-intelligence.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "next": "16.4.6",
    "openai": "7.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "supabase": "3.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.3",
    "vitest": "5.1.1"
  }
}

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Needed only by the local demo user setup script
SUPABASE_SERVICE_ROLE_KEY=
# Set a temporary local-only password of at least 12 characters
FERIA_DEMO_PASSWORD=

# disabled (default), demo (deterministic, labeled), or openai (external request)
FER_INTELLIGENCE_MODE=disabled
# Set both only for an authorized server runtime. The model must support
# Responses API with strict Structured Outputs. Pin the tested model ID.
FER_INTELLIGENCE_MODEL=
OPENAI_API_KEY=
